---
/** All Teams — Figma frame 162:1760, 430 × 2931. */
import Button from '../../components/Button/Button.astro'
import AppNav from '../../components/AppNav/AppNav.astro'
import { ASSETS } from '../../assets/assets'
import TeamCard from './TeamCard.astro'
import { ALL_TEAMS_CARDS } from './content'
import styles from './AllTeams.module.css'

---

<div
  class={styles.page}
  data-node-id="162:1760"
  data-desktop-node-id="377:185"
  data-teams-page
>
  <div class={styles.content} data-node-id="181:1247">
    <header class={styles.header} data-node-id="181:1243">
      <div class={styles.brand} data-node-id="162:1773">
        <p class={styles.brandByline} data-node-id="162:1774">Cody Brown’s</p>
        <p class={styles.brandTitle} data-node-id="162:1775">NFL BETTING GUIDE</p>
      </div>

      <form class={styles.search} data-node-id="162:1776" role="search">
        <span class={styles.searchIcon} data-node-id="181:1230">
          <img src={ASSETS.teamsIconSearch} alt="" aria-hidden="true" />
        </span>
        <label class={styles.visuallyHidden} for="team-search">Search teams</label>
        <input
          id="team-search"
          class={styles.searchInput}
          type="search"
          placeholder="Search your favorite team..."
        />
        <button class={styles.searchClear} type="reset" aria-label="Clear search">
          <img class={styles.searchClearRing} src={ASSETS.teamsClearRing} alt="" />
          <img class={styles.searchClearCross} src={ASSETS.teamsClearCross} alt="" />
        </button>
      </form>
    </header>

    <section class={styles.filters} data-node-id="181:1244" aria-labelledby="teams-heading">
      <h1 id="teams-heading" class={styles.heading} data-node-id="162:1761">ALL 32 TEAMS</h1>
      <div class={styles.filterRow} data-node-id="162:1762">
        <div class={styles.filterChoices} data-node-id="188:2364">
          <Button
            variant="filter"
            label="AFC"
            nodeId="181:297"
            assetSet="teams-page"
            filterValue="AFC"
          />
          <Button
            variant="filter"
            label="NFC"
            showIcon={false}
            nodeId="181:301"
            assetSet="teams-page"
            filterValue="NFC"
          />
          {/*
            * 28 Aug feedback: "keep the 3rd filter 'All' and always active on
            * default state". The design's third chip was "Filter" (a search
            * shortcut); it is now the "All" filter, pressed whenever no
            * conference narrows the grid — the state the page server-renders —
            * matching the All Bets category row's "All" chip.
            */}
          <Button
            variant="filter"
            label="All"
            state="active"
            nodeId="181:305"
            assetSet="teams-page"
            filterValue="all"
          />
        </div>

        <button
          class={styles.clearAll}
          type="button"
          data-node-id="188:2356"
          data-clear-filters
          hidden
        >
          <span class={styles.clearAllIcon} aria-hidden="true">
            <img class={styles.clearAllRing} src={ASSETS.teamsClearRing} alt="" />
            <img class={styles.clearAllCross} src={ASSETS.teamsClearAllCross} alt="" />
          </span>
          <span>Clear All</span>
        </button>
      </div>
    </section>

    <div class={styles.divider} data-node-id="162:1771">
      <img src={ASSETS.teamsDivider} alt="" aria-hidden="true" />
    </div>

    <p class={styles.resultsStatus} role="status" aria-live="polite" data-results-status></p>
    <p class={styles.emptyState} data-empty-results hidden>No teams match your filters.</p>

    <div class={styles.cards} data-node-id="181:325">
      {ALL_TEAMS_CARDS.map((card, index) => <TeamCard card={card} eager={index < 3} />)}
    </div>
  </div>

  <AppNav />
</div>

<script>
  function startTeamsFilterController() {
    const teamsPage = document.querySelector<HTMLElement>('[data-teams-page]')

    // The router keeps this listener for the session, so other routes are a no-op.
    if (teamsPage === null) return

    const searchInput = teamsPage.querySelector<HTMLInputElement>('#team-search')
    const cards = [...teamsPage.querySelectorAll<HTMLElement>('[data-team-card]')]
    const allFilterChips = [
      ...teamsPage.querySelectorAll<HTMLButtonElement>('[data-filter-value]'),
    ]
    // "All" is the default state, not a conference: it stays pressed while no
    // conference narrows the grid (28 Aug feedback).
    const allButton = allFilterChips.find((button) => button.dataset.filterValue === 'all')
    const filterButtons = allFilterChips.filter((button) => button !== allButton)
    const clearAllButton = teamsPage.querySelector<HTMLButtonElement>('[data-clear-filters]')
    const emptyState = teamsPage.querySelector<HTMLElement>('[data-empty-results]')
    const resultsStatus = teamsPage.querySelector<HTMLElement>('[data-results-status]')

    if (
      searchInput === null ||
      allButton === undefined ||
      clearAllButton === null ||
      emptyState === null ||
      resultsStatus === null
    ) {
      throw new Error('All Teams filter controller is missing a required control')
    }

    const requiredAllButton = allButton

    const requiredSearchInput = searchInput
    const requiredClearAllButton = clearAllButton
    const requiredEmptyState = emptyState
    const requiredResultsStatus = resultsStatus

    function setFilter(button: HTMLButtonElement, active: boolean) {
      button.setAttribute('aria-pressed', String(active))
      button.dataset.state = active ? 'active' : 'default'

      let clearIcon = button.querySelector<HTMLElement>('[data-filter-clear]')
      if (clearIcon === null && active) {
        const activeIcon = filterButtons
          .map((candidate) => candidate.querySelector<HTMLElement>('[data-filter-clear]'))
          .find((icon) => icon !== null)

        if (activeIcon === undefined) throw new Error('No conference filter provides an active-state icon')
        clearIcon = activeIcon.cloneNode(true) as HTMLElement
        button.append(clearIcon)
      }

      if (clearIcon === null) return
      clearIcon.hidden = !active
    }

    function applyFilters() {
      // Conferences are additive (28 Aug feedback: multi-select every filter
      // except "All"), so this is a set rather than a single choice.
      const selectedConferences = filterButtons
        .filter((button) => button.getAttribute('aria-pressed') === 'true')
        .map((button) => {
          const value = button.dataset.filterValue
          if (value === undefined) throw new Error('An All Teams filter has no conference value')
          return value
        })

      // "All" reflects the conference state rather than holding its own: it is
      // pressed exactly when no conference chip is.
      const allActive = selectedConferences.length === 0
      requiredAllButton.setAttribute('aria-pressed', String(allActive))
      requiredAllButton.dataset.state = allActive ? 'active' : 'default'
      const allClearIcon = requiredAllButton.querySelector<HTMLElement>('[data-filter-clear]')
      if (allClearIcon === null) throw new Error('The "All" filter is missing its active-state icon')
      allClearIcon.hidden = !allActive

      const query = requiredSearchInput.value.trim().toLocaleLowerCase()
      let visibleCount = 0

      for (const card of cards) {
        const conference = card.dataset.conference
        const matchesConference =
          allActive || (conference !== undefined && selectedConferences.includes(conference))
        const matchesSearch = card.dataset.team?.toLocaleLowerCase().includes(query) ?? false
        const isVisible = matchesConference && matchesSearch
        card.hidden = !isVisible
        if (isVisible) visibleCount += 1
      }

      /*
       * "Clear All" is an escape hatch, not a permanent control: with nothing
       * filtered there is nothing for it to clear, so the row renders without
       * it (27 Aug feedback) and it appears the moment a conference chip goes
       * active or the search field has a query -- the two things it resets.
       */
      requiredClearAllButton.hidden = allActive && query.length === 0
      requiredEmptyState.hidden = visibleCount !== 0
      requiredResultsStatus.textContent = `${visibleCount} ${visibleCount === 1 ? 'team' : 'teams'} shown`
    }

    for (const button of filterButtons) {
      button.addEventListener('click', () => {
        setFilter(button, button.getAttribute('aria-pressed') !== 'true')
        applyFilters()
      })
    }

    // Clicking "All" is a reset to the default view; clicking it while already
    // there is a no-op rather than a deselection.
    requiredAllButton.addEventListener('click', () => {
      for (const button of filterButtons) setFilter(button, false)
      applyFilters()
    })
    searchInput.addEventListener('input', applyFilters)
    // Filtering is client-only; block native submit (Enter) so a reload cannot wipe state.
    searchInput.form?.addEventListener('submit', (event) => event.preventDefault())
    // Reset clears the input after the event; wait a frame so applyFilters reads the empty value.
    searchInput.form?.addEventListener('reset', () => requestAnimationFrame(applyFilters))
    clearAllButton.addEventListener('click', () => {
      searchInput.value = ''
      for (const button of filterButtons) setFilter(button, false)
      applyFilters()
    })

    applyFilters()
  }

  /*
   * Bundled scripts run once per document, so client-side navigation would leave
   * the filters wired to a screen the router has already discarded.
   * astro:page-load fires on the first render and after every swap.
   */
  document.addEventListener('astro:page-load', startTeamsFilterController)
</script>

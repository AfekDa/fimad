---
import Button from '../../components/Button/Button.astro'
import { ASSETS } from '../../assets/assets'
import type { TeamCardContent } from './content'
import styles from './TeamCard.module.css'

export interface Props {
  readonly card: TeamCardContent
}

const { card } = Astro.props
---

<article
  class={styles.card}
  data-node-id={card.nodeId}
  data-team-card
  data-team={card.team}
  data-conference={card.conference}
>
  <div
    class:list={[styles.imageBox, styles[card.crop]]}
    data-node-id={card.imageNodeId}
  >
    <img class={styles.imageLeaf} src={card.image} alt={card.imageAlt} />
  </div>

  {card.crop === 'buffalo' && <div class={styles.scrim} aria-hidden="true"></div>}

  <span class={styles.conference}>AFC</span>

  <div class={styles.details}>
    <span class={styles.teamLogo} data-node-id="181:1340">
      <img
        class={styles.teamLogoLeaf}
        src={ASSETS.teamsLogoBuffalo}
        alt=""
        aria-hidden="true"
      />
    </span>
    <h2 class={styles.teamName}>BALTIMORE RAVENS</h2>
    <Button
      variant="button"
      label="Team Preview"
      nodeId={card.buttonNodeId}
      ariaLabel="Preview Buffalo Bills"
      assetSet="teams-page"
      href={card.href}
      class={styles.preview}
    />
  </div>
</article>

---
import Button from '../../components/Button/Button.astro'
import type { TeamCardContent } from './content'
import styles from './TeamCard.module.css'

export interface Props {
  readonly card: TeamCardContent
}

const { card } = Astro.props
---

<article
  class={styles.card}
  data-node-id={card.nodeId}
  data-team-card
  data-team={card.team}
  data-conference={card.conference}
>
  <div
    class:list={[styles.imageBox, styles[card.crop]]}
    data-node-id={card.imageNodeId}
  >
    <img class={styles.imageLeaf} src={card.image} alt={card.imageAlt} loading="lazy" decoding="async" data-reveal />
  </div>

  {(card.crop === 'buffalo' || card.crop === 'cms') && (
    <div class={styles.scrim} aria-hidden="true"></div>
  )}

  <span class={styles.conference}>{card.conference}</span>

  <div class={styles.details}>
    <span
      class:list={[styles.teamLogo, card.logoIsCms && styles.cmsLogo]}
      style={`--team-logo-scale: ${card.logoScale}`}
      data-node-id="181:1340"
    >
      <picture class={styles.reframedPicture}>
        <source media="(min-width: 768px)" srcset={card.logoDesktop} />
        <img class={styles.teamLogoLeaf} src={card.logo} alt="" aria-hidden="true" loading="lazy" decoding="async" data-reveal />
      </picture>
    </span>
    <h2 class={styles.teamName}>{card.team}</h2>
    <Button
      variant="button"
      label="Team Preview"
      nodeId={card.buttonNodeId}
      ariaLabel={`Preview ${card.team}`}
      assetSet="teams-page"
      href={card.href}
      class={styles.preview}
    />
  </div>
</article>

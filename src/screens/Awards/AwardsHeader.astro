---
import { ASSETS } from '../../assets/assets'
import styles from './Awards.module.css'

export interface Props {
  readonly searchId: string
  readonly searchLabel: string
  readonly clearLabel: string
  /** Hint text in the box; each page says what its search looks for (2 Sep). */
  readonly placeholder?: string | undefined
  /** Extra class for the band, for pages whose band holds more than the search. */
  readonly class?: string | undefined
  readonly nodeIds: {
    readonly header: string
    readonly brand: string
    readonly byline: string
    readonly title: string
    readonly search: string
    readonly searchIcon: string
  }
}

const {
  searchId,
  searchLabel,
  clearLabel,
  placeholder = 'Search your favorite team...',
  nodeIds,
  class: className,
} = Astro.props
---

<header class:list={[styles.header, 'appScrollHeader', className]} data-node-id={nodeIds.header}>
  <div class={styles.brand} data-node-id={nodeIds.brand}>
    <p class={styles.brandByline} data-node-id={nodeIds.byline}>Cody Brown’s</p>
    <p class={styles.brandTitle} data-node-id={nodeIds.title}>NFL BETTING GUIDE</p>
  </div>

  <form class={styles.search} data-node-id={nodeIds.search} role="search">
    <span class={styles.searchIcon} data-node-id={nodeIds.searchIcon}>
      <img src={ASSETS.teamsIconSearch} alt="" aria-hidden="true" />
    </span>
    <label class={styles.visuallyHidden} for={searchId}>{searchLabel}</label>
    <input
      id={searchId}
      class={styles.searchInput}
      type="search"
      placeholder={placeholder}
      data-award-search
    />
    <button class={styles.searchClear} type="reset" aria-label={clearLabel}>
      <img class={styles.searchClearRing} src={ASSETS.teamsClearRing} alt="" />
      <img class={styles.searchClearCross} src={ASSETS.teamsClearCross} alt="" />
    </button>
  </form>

  <slot />
</header>

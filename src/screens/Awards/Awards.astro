---
/** All Awards — Figma frame 188:2037, 430 × 1507 (54px device status bar omitted). */
import AppNav from '../../components/AppNav/AppNav.astro'
import AwardCard from './AwardCard.astro'
import AwardsHeader from './AwardsHeader.astro'
import { AWARD_CARDS } from './content'
import styles from './Awards.module.css'
---

<div class:list={[styles.page, 'appScrollShell']} data-node-id="188:2037" data-awards-page>
  <AwardsHeader
    searchId="award-search"
    searchLabel="Search awards"
    clearLabel="Clear award search"
    nodeIds={{ header: '188:2038', brand: '188:2039', byline: '188:2040', title: '188:2041', search: '188:2042', searchIcon: '188:2043' }}
  />

  {/*
      iOS 26 Safari fills the strip under its address pill with a blurred sample
      of the scrolling layer and refuses to paint fixed or sticky content there,
      so the sticky header could not hide what passed behind it. Everything below
      the header scrolls inside this box, which starts under the header, so no
      content ever reaches the strip. See app.css.
    */}
  <div class:list={[styles.scroller, 'appScrollArea']}>
  <section class={styles.cards} aria-label="Awards" data-node-id="188:2046">
    {AWARD_CARDS.map((card, index) => <AwardCard card={card} eager={index < 3} />)}
  </section>

  <p class={styles.emptyState} data-empty-awards hidden>No awards match your search.</p>
  </div>
  <AppNav />
</div>

<script>
  function startAwardsController() {
    const page = document.querySelector<HTMLElement>('[data-awards-page]')

    // The router keeps this listener for the session, so other routes are a no-op.
    if (page === null) return

    const search = page.querySelector<HTMLInputElement>('[data-award-search]')
    const cards = [...page.querySelectorAll<HTMLElement>('[data-award-card]')]
    const emptyState = page.querySelector<HTMLElement>('[data-empty-awards]')

    if (search === null || cards.length !== 4 || emptyState === null) {
      throw new Error('Awards controller is missing its search, cards, or empty state')
    }

    const requiredSearch = search
    const requiredEmptyState = emptyState

    function applySearch() {
      const query = requiredSearch.value.trim().toLocaleLowerCase()
      let visibleCount = 0

      for (const card of cards) {
        const visible = card.dataset.awardTitle?.toLocaleLowerCase().includes(query) ?? false
        card.hidden = !visible
        if (visible) visibleCount += 1
      }

      requiredEmptyState.hidden = visibleCount !== 0
    }

    search.addEventListener('input', applySearch)
    search.form?.addEventListener('submit', (event) => event.preventDefault())
    search.form?.addEventListener('reset', () => requestAnimationFrame(applySearch))
  }

  /*
   * Bundled scripts run once per document, so client-side navigation would leave
   * the search wired to a screen the router has already discarded. astro:page-load
   * fires on the first render and after every swap.
   */
  document.addEventListener('astro:page-load', startAwardsController)
</script>

---
/** All Awards — Figma frame 188:2037, 430 × 1507 (54px device status bar omitted). */
import { ASSETS } from '../../assets/assets'
import AppNav from '../../components/AppNav/AppNav.astro'
import AwardCard from './AwardCard.astro'
import { AWARD_CARDS } from './content'
import styles from './Awards.module.css'
---

<div class={styles.page} data-node-id="188:2037" data-awards-page>
  <header class={styles.header} data-node-id="188:2038">
    <div class={styles.brand} data-node-id="188:2039">
      <p class={styles.brandByline} data-node-id="188:2040">Cody Brown’s</p>
      <p class={styles.brandTitle} data-node-id="188:2041">NFL BETTING GUIDE</p>
    </div>

    <form class={styles.search} data-node-id="188:2042" role="search">
      <span class={styles.searchIcon} data-node-id="188:2043">
        <img src={ASSETS.teamsIconSearch} alt="" aria-hidden="true" />
      </span>
      <label class={styles.visuallyHidden} for="award-search">Search awards</label>
      <input
        id="award-search"
        class={styles.searchInput}
        type="search"
        placeholder="Search your favorite team..."
        data-award-search
      />
      <button class={styles.searchClear} type="reset" aria-label="Clear award search">
        <img class={styles.searchClearRing} src={ASSETS.teamsClearRing} alt="" />
        <img class={styles.searchClearCross} src={ASSETS.teamsClearCross} alt="" />
      </button>
    </form>
  </header>

  <section class={styles.cards} aria-label="Awards" data-node-id="188:2046">
    {AWARD_CARDS.map((card) => <AwardCard card={card} />)}
  </section>

  <p class={styles.emptyState} data-empty-awards hidden>No awards match your search.</p>
  <AppNav />
</div>

<script>
  const page = document.querySelector<HTMLElement>('[data-awards-page]')

  if (page === null) throw new Error('Awards controller requires its page root')

  const search = page.querySelector<HTMLInputElement>('[data-award-search]')
  const cards = [...page.querySelectorAll<HTMLElement>('[data-award-card]')]
  const emptyState = page.querySelector<HTMLElement>('[data-empty-awards]')

  if (search === null || cards.length !== 4 || emptyState === null) {
    throw new Error('Awards controller is missing its search, cards, or empty state')
  }

  const requiredSearch = search
  const requiredEmptyState = emptyState

  function applySearch() {
    const query = requiredSearch.value.trim().toLocaleLowerCase()
    let visibleCount = 0

    for (const card of cards) {
      const visible = card.dataset.awardTitle?.toLocaleLowerCase().includes(query) ?? false
      card.hidden = !visible
      if (visible) visibleCount += 1
    }

    requiredEmptyState.hidden = visibleCount !== 0
  }

  search.addEventListener('input', applySearch)
  search.form?.addEventListener('submit', (event) => event.preventDefault())
  search.form?.addEventListener('reset', () => requestAnimationFrame(applySearch))
</script>

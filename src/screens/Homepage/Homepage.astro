---
/**
 * Homepage — Figma frame 1:90, 430 x 1697.
 *
 * Structure and styling only. Every string and image url comes from
 * ./content.ts; images resolve through the registry in src/assets/assets.ts.
 */
import Nav from '../../components/Nav/Nav.astro'
import { ASSETS } from '../../assets/assets'
import { HOMEPAGE_CONTENT as content } from './content'
import styles from './Homepage.module.css'
---

<div class={styles.page} data-node-id="1:90">
  <div class={styles.hero}>
    <div class={styles.heroImage} data-node-id="1:91">
      <img class={styles.heroImageLeaf} src={content.hero.poster} alt="" aria-hidden="true" />
    </div>
    <div class={styles.heroScrim} data-node-id="1:92"></div>
    <div class={styles.heroTitle} data-node-id="1:93">
      <div class={styles.yearMark} data-node-id="1:95">
        <img
          class={styles.yearMarkLeaf}
          src={content.hero.yearMark}
          alt={content.hero.yearMarkAlt}
        />
      </div>
    </div>
  </div>

  <div class={styles.content} data-node-id="1:96">
    <h1 class={styles.title} data-node-id="1:97">
      {content.headline}
    </h1>

    {/* Written on one line: Astro preserves template whitespace, so indenting
        the fragments would insert a space around the breaks. */}
    <p class={styles.body} data-node-id="1:98">
      {content.intro.map((paragraph, index) => (<Fragment>{index > 0 && <Fragment><br aria-hidden="true" /><br aria-hidden="true" /></Fragment>}{paragraph}</Fragment>))}
    </p>

    <ul class={styles.features} data-node-id="1:99">
      {
        content.features.map((feature) => (
          <li class={styles.featureCard} data-node-id={feature.nodeId}>
            <span class={styles.featureBadge}>
              <img
                class={styles.featureBadgeLeaf}
                src={ASSETS.featureBadge}
                alt=""
                aria-hidden="true"
              />
            </span>
            {/* Written on one line: Astro preserves template whitespace, so
                indenting the spans would insert a space into the text. */}
            <p class={styles.featureText}>
              {feature.lines.map((line, index) => (<span>{index > 0 && <br />}{line}</span>))}
            </p>
          </li>
        ))
      }
    </ul>

    <p class={styles.body} data-node-id="1:112">
      {content.outro}
    </p>

    <div class={styles.divider} data-node-id="1:113">
      <img class={styles.dividerLeaf} src={ASSETS.divider} alt="" aria-hidden="true" />
    </div>

    <div class={styles.footer} data-node-id="1:114">
      <div class={styles.identity} data-node-id="1:115">
        <span class={styles.avatar} data-node-id="1:116">
          <img class={styles.avatarLeaf} src={content.author.avatar} alt="" aria-hidden="true" />
        </span>
        <img class={styles.signature} src={content.author.signature} alt={content.author.name} />
      </div>

      <div class={styles.social} data-node-id="1:118">
        {
          content.social.map((link) => (
            <button
              type="button"
              class={styles.socialLink}
              data-node-id={link.nodeId}
              aria-label={link.label}
            >
              <img class={styles.socialIcon} src={link.src} alt="" aria-hidden="true" />
            </button>
          ))
        }
      </div>
    </div>
  </div>

  <div class={styles.navDock} data-node-id="1:126">
    <Nav class={styles.nav} selectedId="home" />
  </div>
</div>

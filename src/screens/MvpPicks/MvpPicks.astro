---
import { ASSETS } from '../../assets/assets'
import AppNav from '../../components/AppNav/AppNav.astro'
import AwardsHeader from '../Awards/AwardsHeader.astro'
import MvpPickCard from './MvpPickCard.astro'
import { MVP_PICKS } from './content'
import type { MvpPickContent } from './content'
import styles from './MvpPicks.module.css'

export interface Props {
  /**
   * Defaults to the design’s own three cards, so /awards/mvp — the frame the
   * Playwright suite measures against — renders exactly as it always has.
   */
  readonly picks?: readonly MvpPickContent[]
  /** Award title from the CMS; the design's own MVP wording when absent. */
  readonly title?: string | undefined
  /**
   * The shorter desktop wording (188:2286 drops the word "PICKS").
   *
   * The CMS publishes it as the award's subtitle; without one the desktop
   * heading falls back to the title it is a variation of.
   */
  readonly subtitle?: string | undefined
}

const {
  picks = MVP_PICKS,
  title = 'MOST VALUABLE PLAYER PICKS',
  subtitle,
} = Astro.props
---

<div class:list={[styles.page, 'appScrollShell']} data-node-id="188:2186" data-mvp-picks-page>
  {/*
    * 28 Aug feedback (updated frame 938:6081): "Back to all Awards" rides in
    * the frozen search band like the Individual Team page's back control, and
    * the award title scrolls with the cards instead.
    */}
  <AwardsHeader
    searchId="mvp-search"
    searchLabel="Search picks"
    clearLabel="Clear pick search"
    class={styles.headerBand}
    nodeIds={{ header: '938:6081', brand: '938:6082', byline: '938:6083', title: '938:6084', search: '938:6086', searchIcon: '938:6087' }}
  >
    <a class={styles.backLink} href="/awards" data-node-id="938:6090">
      <span class={styles.backIcon} aria-hidden="true">
        <img src={ASSETS.arrowGrey} alt="" />
      </span>
      <span>Back to all Awards</span>
    </a>
  </AwardsHeader>

  {/*
    iOS 26 Safari fills the strip under its address pill with a blurred sample
    of the scrolling layer and refuses to paint fixed or sticky content there.
    Everything below the header scrolls inside this box, which starts under the
    header, so no content ever reaches the strip. See app.css.
  */}
  <div class:list={[styles.scroller, 'appScrollArea']}>
  <div class={styles.intro} data-node-id="188:2480">
    <h1 class={styles.heading} data-node-id="188:2286">
      <span class={styles.mobileHeading}>{title}</span>
      <span class={styles.desktopHeading}>{subtitle ?? title}</span>
    </h1>
  </div>

  <section class={styles.carousel} aria-label="Most valuable player picks" data-node-id="188:2195" data-picks-carousel>
    {picks.map((pick, index) => <MvpPickCard pick={pick} eager={index < 3} />)}
  </section>

  <p class={styles.emptyState} data-empty-picks hidden>No picks match your search.</p>
  </div>

  <AppNav />
</div>

<script>
  function startPicksController() {
    const page = document.querySelector<HTMLElement>('[data-mvp-picks-page]')

    // The router keeps this listener for the session, so other routes are a no-op.
    if (page === null) return

    const search = page.querySelector<HTMLInputElement>('[data-award-search]')
    const carousel = page.querySelector<HTMLElement>('[data-picks-carousel]')
    const cards = [...page.querySelectorAll<HTMLElement>('[data-mvp-card]')]
    const emptyState = page.querySelector<HTMLElement>('[data-empty-picks]')

    if (search === null || carousel === null || cards.length === 0 || emptyState === null) {
      throw new Error('Picks controller is missing its search, carousel, cards, or empty state')
    }

    const requiredSearch = search
    const requiredCarousel = carousel
    const requiredEmptyState = emptyState

    /*
     * The cards on this page are one award's picks, so the search matches the
     * player each card names — the same way /awards matches an award's title.
     */
    function applySearch() {
      const query = requiredSearch.value.trim().toLocaleLowerCase()
      let visibleCount = 0

      for (const card of cards) {
        const visible = card.dataset.mvpName?.toLocaleLowerCase().includes(query) ?? false
        card.hidden = !visible
        if (visible) visibleCount += 1
      }

      /*
       * The carousel holds a fixed 505px row whether or not a card is left in
       * it, so it has to go as well — otherwise the message strands below an
       * empty band the height of the cards it used to hold.
       */
      requiredCarousel.hidden = visibleCount === 0
      requiredEmptyState.hidden = visibleCount !== 0
    }

    search.addEventListener('input', applySearch)
    search.form?.addEventListener('submit', (event) => event.preventDefault())
    search.form?.addEventListener('reset', () => requestAnimationFrame(applySearch))
  }

  /*
   * Bundled scripts run once per document, so client-side navigation would leave
   * the search wired to a screen the router has already discarded. astro:page-load
   * fires on the first render and after every swap.
   */
  document.addEventListener('astro:page-load', startPicksController)
</script>

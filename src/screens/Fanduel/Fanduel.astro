---
/** FanDuel Page — desktop Figma frame 803:5180. */
import { ASSETS } from '../../assets/assets'
import AppNav from '../../components/AppNav/AppNav.astro'
import Button from '../../components/Button/Button.astro'
import AwardsHeader from '../Awards/AwardsHeader.astro'
import styles from './Fanduel.module.css'
---

<div class={styles.page} data-node-id="803:5180" data-fanduel-page>
  <AwardsHeader
    searchId="fanduel-search"
    searchLabel="Search FanDuel offers"
    clearLabel="Clear FanDuel offer search"
    nodeIds={{ header: '803:5181', brand: '803:5182', byline: '803:5183', title: '803:5184', search: '803:5185', searchIcon: '803:5186' }}
  />

  <section class={styles.offers} aria-label="FanDuel offers">
    <article class:list={[styles.offer, styles.rewards]} data-node-id="803:5554" data-fanduel-offer>
      <img class={styles.rewardsImage} src={ASSETS.fanduelRewardsClub} alt="FanDuel Rewards Club" data-node-id="803:5555" />
      <div class={styles.rewardsContent}>
        <div class={styles.pointRows} aria-label="Rewards Club features">
          <div class={styles.pointRow} data-node-id="803:5557"><span>COLLECT POINTS</span><span>+1</span></div>
          <div class={styles.pointRow} data-node-id="803:5560"><span>UNLOCK LEVELS</span><span>+1</span></div>
          <div class={styles.pointRow} data-node-id="803:5563"><span>SCORE REWARDS</span><span>+1</span></div>
        </div>
        <Button variant="fanduel" state="active" label="REDEEM OFFER" nodeId="803:5566" ariaLabel="Redeem Rewards Club offer" width={175} />
      </div>
    </article>

    <article class:list={[styles.offer, styles.standardOffer]} data-node-id="803:5568" data-fanduel-offer>
      <img class={styles.offerImage} src={ASSETS.fanduelOffer} alt="Your most rewarding season ever" data-node-id="803:5569" />
      <div class={styles.standardContent}>
        <div class={styles.copy} data-node-id="803:5570">
          <h1 data-node-id="803:5571">TITLE OF THE OFFER</h1>
          <p data-node-id="803:5572">Lorem ipsum dolor sit amet consectetur. Sit fermentum aliquet vestibulum et vitae. Lorem id lobortis vitae duis ac morbi eu malesuada. Nisl pellentesque aliquet aliquet aliquam enim mauris. Neque vestibulum sit quam vitae. Cursus amet morbi lectus arcu tellus mattis. A neque nisi praesent vel tempor nascetur lobortis. Aliquet ipsum sed tortor tempus.</p>
        </div>
        <Button variant="fanduel" state="active" label="REDEEM OFFER" nodeId="803:5573" ariaLabel="Redeem offer" width={175} />
      </div>
    </article>
  </section>

  <AppNav />
</div>

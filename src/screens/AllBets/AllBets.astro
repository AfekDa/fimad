---
/** All Bets — Figma frame 251:2889, 430 × 4915 (54px device status bar omitted). */
import AppNav from '../../components/AppNav/AppNav.astro'
import Button from '../../components/Button/Button.astro'
import { ASSETS } from '../../assets/assets'
import BetCard from './BetCard.astro'
import { BET_FILTERS, BET_SECTIONS } from './content'
import styles from './AllBets.module.css'
---

<div class:list={[styles.page, 'appScrollShell']} data-node-id="251:2889" data-all-bets-page>
  <header class:list={[styles.header, 'appScrollHeader']} data-node-id="251:2892">
    <div class={styles.brand} data-node-id="251:2893">
      <p class={styles.brandByline} data-node-id="251:2894">Cody Brown’s</p>
      <p class={styles.brandTitle} data-node-id="251:2895">NFL BETTING GUIDE</p>
    </div>

    <form class={styles.search} data-node-id="251:2896" role="search">
      <span class={styles.searchIcon} data-node-id="251:2897">
        <img src={ASSETS.teamsIconSearch} alt="" aria-hidden="true" />
      </span>
      <label class={styles.visuallyHidden} for="bet-search">Search bets</label>
      <input
        id="bet-search"
        class={styles.searchInput}
        type="search"
        placeholder="Search your favorite team..."
        data-bet-search
      />
      <button class={styles.searchClear} type="reset" aria-label="Clear bet search">
        <img class={styles.searchClearRing} src={ASSETS.teamsClearRing} alt="" />
        <img class={styles.searchClearCross} src={ASSETS.teamsClearCross} alt="" />
      </button>
    </form>
  </header>

  {/*
      iOS 26 Safari fills the strip under its address pill with a blurred sample
      of the scrolling layer and refuses to paint fixed or sticky content there,
      so the sticky header could not hide what passed behind it. Everything below
      the header scrolls inside this box, which starts under the header, so no
      content ever reaches the strip. See app.css.
    */}
  <div class:list={[styles.scroller, 'appScrollArea']}>
  <section class={styles.filters} aria-label="Bet categories" data-node-id="251:3065">
    <div class={styles.filterRow} data-node-id="251:3001">
      {
        BET_FILTERS.slice(0, 2).map((filter) => (
          <Button
            variant="filter"
            state={filter.id === 'all' ? 'active' : 'default'}
            label={filter.label}
            nodeId={filter.id === 'all' ? '251:3002' : '251:3003'}
            assetSet="teams-page"
            filterValue={filter.id}
          />
        ))
      }
    </div>
    <div class={styles.filterRow} data-node-id="251:3021">
      {
        BET_FILTERS.slice(2, 4).map((filter, index) => (
          <Button
            variant="filter"
            label={filter.label}
            nodeId={index === 0 ? '251:3023' : '251:3031'}
            assetSet="teams-page"
            filterValue={filter.id}
          />
        ))
      }
    </div>
    <div class={styles.filterRow} data-node-id="251:3034">
      <Button
        variant="filter"
        label={BET_FILTERS[4].label}
        nodeId="251:3035"
        assetSet="teams-page"
        filterValue={BET_FILTERS[4].id}
      />
    </div>
    <div class={styles.filterRow} data-node-id="251:3039">
      <Button
        variant="filter"
        label={BET_FILTERS[5].label}
        nodeId="251:3040"
        assetSet="teams-page"
        filterValue={BET_FILTERS[5].id}
      />

      <button class={styles.clearAll} type="button" data-node-id="791:3532" data-clear-filters hidden>
        <span class={styles.clearAllIcon} aria-hidden="true">
          <img class={styles.clearAllRing} src={ASSETS.teamsClearRing} alt="" />
          <img class={styles.clearAllCross} src={ASSETS.teamsClearAllCross} alt="" />
        </span>
        <span>Clear All</span>
      </button>
    </div>
  </section>

  <div class={styles.sections} data-node-id="251:3311">
    <div class={styles.divider} data-node-id="251:3063">
      <img src={ASSETS.teamsDivider} alt="" aria-hidden="true" />
    </div>

    {
      BET_SECTIONS.map((section) => (
        <Fragment>
          <section
            class={styles.betSection}
            data-node-id={section.frameNodeId}
            data-bet-section={section.id}
          >
            <h1 class={styles.sectionTitle} data-node-id={section.headingNodeId}>
              {section.title}
            </h1>
            <div class={styles.betList}>
              {section.bets.map((bet) => <BetCard bet={bet} />)}
            </div>
          </section>
          {section !== BET_SECTIONS.at(-1) && (
            <div class={styles.divider} aria-hidden="true">
              <img src={ASSETS.teamsDivider} alt="" />
            </div>
          )}
        </Fragment>
      ))
    }
  </div>

  <p class={styles.emptyState} data-empty-bets hidden>No bets match your filters.</p>
  </div>
  <AppNav />
</div>

<script>
  function startAllBetsController() {
    const page = document.querySelector<HTMLElement>('[data-all-bets-page]')

    // The router keeps this listener for the session, so other routes are a no-op.
    if (page === null) return

    const search = page.querySelector<HTMLInputElement>('[data-bet-search]')
    const filterButtons = [...page.querySelectorAll<HTMLButtonElement>('[data-filter-value]')]
    const sections = [...page.querySelectorAll<HTMLElement>('[data-bet-section]')]
    const emptyState = page.querySelector<HTMLElement>('[data-empty-bets]')
    const clearAllButton = page.querySelector<HTMLButtonElement>('[data-clear-filters]')

    if (
      search === null ||
      filterButtons.length !== 6 ||
      sections.length !== 5 ||
      emptyState === null ||
      clearAllButton === null
    ) {
      throw new Error('All Bets controller is missing required filters, sections, or search controls')
    }

    const requiredSearch = search
    const requiredEmptyState = emptyState
    const requiredClearAllButton = clearAllButton

    const allFilter = filterButtons.find((button) => button.dataset.filterValue === 'all')
    if (allFilter === undefined) throw new Error('All Bets is missing its "All" category filter')

    /*
     * "All" is an explicit choice, not a derived fallback: it shows everything
     * and never combines with a category. Deselecting the last category is
     * therefore an empty selection, which shows nothing rather than silently
     * snapping back to "All" (28 Aug feedback: "nothing is selected and I
     * still see things").
     */
    const categoryButtons = filterButtons.filter((button) => button !== allFilter)
    const requiredAllFilter = allFilter

    function setFilter(button: HTMLButtonElement, active: boolean) {
      button.dataset.state = active ? 'active' : 'default'
      button.setAttribute('aria-pressed', String(active))
      const clear = button.querySelector<HTMLElement>('[data-filter-clear]')
      if (clear === null) throw new Error('All Bets filter is missing its clear-state icon')
      clear.hidden = !active
    }

    function selectedCategories() {
      return categoryButtons
        .filter((button) => button.getAttribute('aria-pressed') === 'true')
        .map((button) => {
          const value = button.dataset.filterValue
          if (value === undefined) throw new Error('Selected All Bets filter has no category value')
          return value
        })
    }

    function resetToAll() {
      for (const button of categoryButtons) setFilter(button, false)
      setFilter(requiredAllFilter, true)
    }

    function applyFilters() {
      const categories = selectedCategories()
      const showEverything = requiredAllFilter.getAttribute('aria-pressed') === 'true'

      const query = requiredSearch.value.trim().toLocaleLowerCase()
      let visibleCards = 0

      for (const section of sections) {
        const sectionId = section.dataset.betSection
        if (sectionId === undefined) throw new Error('An All Bets section has no category value')
        // Categories are additive. With neither "All" nor a category chosen
        // nothing qualifies, so the screen empties out.
        const categoryMatches = showEverything || categories.includes(sectionId)
        let sectionMatches = 0

        for (const card of section.querySelectorAll<HTMLElement>('[data-bet-card]')) {
          const searchMatches = card.dataset.player?.toLocaleLowerCase().includes(query) ?? false
          const visible = categoryMatches && searchMatches
          card.hidden = !visible
          if (visible) sectionMatches += 1
        }

        section.hidden = sectionMatches === 0
        visibleCards += sectionMatches
      }

      requiredEmptyState.hidden = visibleCards !== 0

      /*
       * "Clear All" is an escape hatch, not a permanent control, so "nothing to
       * clear" is the unfiltered "All" view with an empty search (27 Aug
       * feedback). An empty selection is something to clear: it is the state
       * the escape hatch exists to get out of.
       */
      requiredClearAllButton.hidden = showEverything && query.length === 0
    }

    for (const button of categoryButtons) {
      button.addEventListener('click', () => {
        setFilter(button, button.getAttribute('aria-pressed') !== 'true')
        // Touching a category always leaves "All", whether that lands on a
        // narrower list or on an empty selection.
        setFilter(requiredAllFilter, false)
        applyFilters()
      })
    }

    // Clicking "All" is a reset to the unfiltered view; clicking it while
    // already there is a no-op rather than a deselection.
    allFilter.addEventListener('click', () => {
      resetToAll()
      applyFilters()
    })

    clearAllButton.addEventListener('click', () => {
      requiredSearch.value = ''
      resetToAll()
      applyFilters()
    })

    search.addEventListener('input', applyFilters)
    search.form?.addEventListener('submit', (event) => event.preventDefault())
    search.form?.addEventListener('reset', () => requestAnimationFrame(applyFilters))
  }

  /*
   * Bundled scripts run once per document, so client-side navigation would leave
   * the filters wired to a screen the router has already discarded.
   * astro:page-load fires on the first render and after every swap.
   */
  document.addEventListener('astro:page-load', startAllBetsController)
</script>

---
/**
 * Document shell shared by every page.
 *
 * Owns the global stylesheets only — layout and design values live with the
 * screens and components, and every Figma-derived value lives in tokens.css.
 *
 * ClientRouter also makes this the owner of section-to-section motion: tabs swap
 * screens in place instead of tearing down the document. The dock is part of
 * each screen, so the fade covers the whole page, nav included.
 */
import { ClientRouter } from 'astro:transitions'
import '../styles/reset.css'
import '../styles/fonts.css'
import '../styles/tokens.css'
import '../styles/app.css'

export interface Props {
  readonly title: string
}

const { title } = Astro.props

/*
 * The outgoing screen holds at full opacity while the incoming one fades in over
 * it. A symmetric cross-fade would leave both snapshots part-transparent
 * mid-flight, showing the white document canvas through two dark screens.
 */
const crossFade = {
  old: {
    name: 'sectionHold',
    duration: 'var(--motion-duration-page)',
    easing: 'linear',
    fillMode: 'both',
  },
  new: {
    name: 'sectionFadeIn',
    duration: 'var(--motion-duration-page)',
    easing: 'var(--motion-ease-page)',
    fillMode: 'both',
  },
}
---

<!doctype html>
<html lang="en" transition:name="root" transition:animate={{ forwards: crossFade, backwards: crossFade }}>
  <head>
    <meta charset="UTF-8" />
    {/*
      `viewport-fit=cover` is required, not optional, on iOS 26. It is what makes
      Safari report its floating controls through env(safe-area-inset-top) --
      about 86px on an iPhone 14 -- which is the only way the page can lay itself
      out around them. Without it the inset reads 0 and the header rides up under
      the address pill.
    */}
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#011556" />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    <slot />
    <script>
      // Pairs with img[data-reveal] in app.css: images still downloading are
      // hidden, then faded in once decoded, so remote CMS bitmaps never paint
      // in half-loaded. astro:page-load fires on the initial load and after
      // every ClientRouter swap, so swapped-in screens get wired too.
      document.addEventListener("astro:page-load", () => {
        for (const img of document.querySelectorAll<HTMLImageElement>("img[data-reveal]")) {
          if (img.complete && img.naturalWidth > 0) continue
          img.classList.add("is-pending")
          const done = () => img.classList.remove("is-pending")
          img.addEventListener("load", done, { once: true })
          img.addEventListener("error", done, { once: true })
        }
      })
    </script>
  </body>
</html>

<style is:global>
  @keyframes sectionHold {
    from,
    to {
      opacity: 1;
    }
  }

  @keyframes sectionFadeIn {
    from {
      opacity: 0;
    }

    to {
      opacity: 1;
    }
  }
</style>

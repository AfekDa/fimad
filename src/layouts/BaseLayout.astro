---
/**
 * Document shell shared by every page.
 *
 * Owns the global stylesheets only — layout and design values live with the
 * screens and components, and every Figma-derived value lives in tokens.css.
 *
 * ClientRouter also makes this the owner of section-to-section motion: tabs swap
 * screens in place instead of tearing down the document. The dock is part of
 * each screen but names its own transition group (see AppNav), so it swaps
 * without fading while the rest of the page cross-fades.
 */
import { ClientRouter } from 'astro:transitions'
import { BUILD_ID } from '../data/buildId'
import '../styles/reset.css'
import '../styles/fonts.css'
import '../styles/tokens.css'
import '../styles/app.css'

export interface Props {
  readonly title: string
}

const { title } = Astro.props

/*
 * The outgoing screen holds at full opacity while the incoming one fades in over
 * it. A symmetric cross-fade would leave both snapshots part-transparent
 * mid-flight, showing the white document canvas through two dark screens.
 */
const crossFade = {
  old: {
    name: 'sectionHold',
    duration: 'var(--motion-duration-page)',
    easing: 'linear',
    fillMode: 'both',
  },
  new: {
    name: 'sectionFadeIn',
    duration: 'var(--motion-duration-page)',
    easing: 'var(--motion-ease-page)',
    fillMode: 'both',
  },
}
---

<!doctype html>
<html lang="en" transition:name="root" transition:animate={{ forwards: crossFade, backwards: crossFade }}>
  <head>
    <meta charset="UTF-8" />
    {/*
      `viewport-fit=cover` is required, not optional, on iOS 26. It is what makes
      Safari report its floating controls through env(safe-area-inset-top) --
      about 86px on an iPhone 14 -- which is the only way the page can lay itself
      out around them. Without it the inset reads 0 and the header rides up under
      the address pill.
    */}
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#011556" />
    <meta name="app-build" content={BUILD_ID} />
    <title>{title}</title>
    <ClientRouter />
    <script>
      import type { TransitionBeforePreparationEvent } from 'astro:transitions/client'

      /*
       * Deploy guard. The router fetches the next page, preloads its
       * stylesheets, and swaps whether or not those preloads succeeded. A
       * deploy replaces the site's hashed files, so a tab opened before it
       * could swap in bare HTML. Before the swap, every stylesheet and script
       * the next page needs that this page does not already have is checked;
       * if any is missing, the navigation is handed to the browser, which
       * loads that page and its own assets together.
       *
       * This is the fallback, not the fix: the deploy keeps three days of
       * earlier builds' assets published (scripts/carry-assets.mjs), so the
       * hand-off -- a visible flash -- only happens for a tab older than that.
       *
       * The check is on the assets themselves, not on the build stamp: a
       * content-only deploy keeps the same hashed CSS, and reloading for a new
       * stamp alone put a flash on the first tab change after every deploy
       * (2 Sep report on the Awards page).
       */
      type Asset = { readonly url: string; readonly as: 'style' | 'script' }

      const assets = (root: ParentNode): Asset[] =>
        [...root.querySelectorAll<HTMLLinkElement | HTMLScriptElement>('link[rel="stylesheet"], script[src]')].flatMap(
          (el) => {
            const isStyle = el instanceof HTMLLinkElement
            const url = el.getAttribute(isStyle ? 'href' : 'src')
            return url === null ? [] : [{ url, as: isStyle ? 'style' : 'script' } as const]
          },
        )

      /*
       * Probed with a preload link rather than fetch(): WebKit crashed the
       * page when a fetch for a stylesheet ran alongside the router's own
       * preload of it. A second preload of the same URL is deduplicated by
       * the browser but still reports load or error to its own element.
       */
      const isMissing = (asset: Asset) =>
        new Promise<boolean>((resolve) => {
          const probe = document.createElement('link')
          probe.rel = asset.as === 'style' ? 'preload' : 'modulepreload'
          if (asset.as === 'style') probe.as = 'style'
          probe.href = asset.url
          probe.addEventListener('load', () => resolve(false), { once: true })
          probe.addEventListener('error', () => resolve(true), { once: true })
          document.head.append(probe)
        })

      document.addEventListener('astro:before-preparation', (event) => {
        const preparation = event as TransitionBeforePreparationEvent
        const load = preparation.loader
        preparation.loader = async () => {
          await load()
          if (preparation.defaultPrevented || preparation.signal.aborted) return
          const have = new Set(assets(document).map((asset) => asset.url))
          const needed = assets(preparation.newDocument).filter((asset) => !have.has(asset.url))
          const results = await Promise.all(needed.map(isMissing))
          if (results.some(Boolean)) {
            preparation.preventDefault()
            window.location.assign(preparation.to.href)
          }
        }
      })
    </script>
    {/*
      Zaraz loader. bets.codybrownbetting.com is a grey-cloud CNAME to GitHub
      Pages, so Cloudflare never sees its traffic and cannot inject this itself;
      orange-clouding the apex would permanently block GitHub's certificate
      renewal, so it stays grey. Cloudflare's documented workaround for exactly
      this case is a second, proxied subdomain that serves /cdn-cgi/zaraz/ from
      the edge -- cdn.codybrownbetting.com, an A record to 192.0.2.1 that routes
      nowhere because Cloudflare answers /cdn-cgi/* before any origin is asked.

      The visitor's real IP reaches Cloudflare on this request, which is what
      lets the server-side GA4 tool resolve US states. That depends on `Hide
      Originating IP Address` being OFF in the tool's settings; switched on, GA4
      geolocates Cloudflare's worker instead of the visitor.

      `is:inline` keeps Astro from pulling a third-party URL into the bundle.
      Placed last in <head> per Cloudflare's docs, so the pageview fires before
      first paint; ClientRouter navigations are picked up separately, because
      Zaraz patches pushState and listens for popstate.
    */}
    <script is:inline src="https://cdn.codybrownbetting.com/cdn-cgi/zaraz/i.js"></script>
  </head>
  <body>
    <slot />
    <script>
      // Pairs with img[data-reveal] in app.css: images still downloading are
      // hidden, then faded in once decoded, so remote CMS bitmaps never paint
      // in half-loaded. astro:page-load fires on the initial load and after
      // every ClientRouter swap, so swapped-in screens get wired too.
      document.addEventListener("astro:page-load", () => {
        for (const img of document.querySelectorAll<HTMLImageElement>("img[data-reveal]")) {
          if (img.complete && img.naturalWidth > 0) continue
          img.classList.add("is-pending")
          const done = () => img.classList.remove("is-pending")
          img.addEventListener("load", done, { once: true })
          img.addEventListener("error", done, { once: true })
        }
      })
    </script>
  </body>
</html>

<style is:global>
  /*
   * The nav's active line (AppNav) is its own transition group, so the browser
   * animates its box from the old tab to the new one. Give that slide the
   * page's own timing rather than the UA default, and a firm settle.
   */
  ::view-transition-group(app-nav-line) {
    animation-duration: var(--motion-duration-page);
    animation-timing-function: cubic-bezier(0.2, 0, 0, 1);
  }

  @keyframes navLineHide {
    from,
    to {
      opacity: 0;
    }
  }

  @keyframes navLineShow {
    from,
    to {
      opacity: 1;
    }
  }

  @keyframes sectionHold {
    from,
    to {
      opacity: 1;
    }
  }

  @keyframes sectionFadeIn {
    from {
      opacity: 0;
    }

    to {
      opacity: 1;
    }
  }
</style>

---
/**
 * Button / Filter — Figma frame "Button/Filter" (1:19).
 *
 * Four types x two states, exactly as the sheet defines them:
 *   Secondary Button (1:20 / 1:23), Button (1:26 / 1:29),
 *   Filter (1:32 / 1:34), Fanduel (1:37 / 1:40).
 */
import styles from './Button.module.css'
import { ASSETS } from '../../assets/assets'

/** Figma variant property "Type" on component set 1:19. */
export type ButtonType = 'secondary' | 'button' | 'filter' | 'fanduel'
/** Figma variant property "State". */
export type ButtonState = 'default' | 'active'

export interface Props {
  readonly variant: ButtonType
  readonly state?: ButtonState
  readonly label: string
  /** Figma boolean property "Functional Icon". */
  readonly showIcon?: boolean
  readonly class?: string | undefined
  readonly nodeId?: string | undefined
  readonly ariaLabel?: string | undefined
  readonly assetSet?: 'default' | 'teams-page'
  readonly href?: string | undefined
  /** Optional client-side filter identifier for filter buttons. */
  readonly filterValue?: string | undefined
}

const NODE_IDS: Record<ButtonType, Record<ButtonState, string>> = {
  secondary: { default: '1:20', active: '1:23' },
  button: { default: '1:26', active: '1:29' },
  filter: { default: '1:32', active: '1:34' },
  fanduel: { default: '1:37', active: '1:40' },
}

const {
  variant,
  state = 'default',
  label,
  showIcon = true,
  class: className,
  nodeId,
  ariaLabel,
  assetSet = 'default',
  href,
  filterValue,
} = Astro.props

const active = state === 'active'
const Element = href === undefined ? 'button' : 'a'

const variantClass =
  variant === 'secondary'
    ? [styles.secondary, active ? styles.secondaryActive : styles.secondaryDefault]
    : variant === 'button'
      ? [styles.button, active ? styles.buttonActive : styles.buttonDefault]
      : variant === 'filter'
        ? [styles.filter, active ? styles.filterActive : styles.filterDefault]
        : [styles.fanduel, active ? styles.fanduelActive : styles.fanduelDefault]
---

<Element
  type={href === undefined ? 'button' : undefined}
  href={href}
  class:list={[styles.base, variantClass, className]}
  data-node-id={nodeId ?? NODE_IDS[variant][state]}
  data-state={state}
  data-asset-set={assetSet}
  data-filter-value={filterValue}
  aria-label={ariaLabel}
  aria-pressed={variant === 'filter' ? (active ? 'true' : 'false') : undefined}
>
  {
    variant === 'secondary' && (
      <Fragment>
        {showIcon && (
          <span class={styles.arrow}>
            <img
              class={styles.arrowLeaf}
              src={active ? ASSETS.arrowBlue : ASSETS.arrowGrey}
              alt=""
              aria-hidden="true"
            />
          </span>
        )}
        <span class={styles.secondaryLabel}>{label}</span>
      </Fragment>
    )
  }

  {
    variant === 'button' && (
      <Fragment>
        <span class={styles.buttonLabel}>{label}</span>
        {showIcon && (
          <span class={styles.arrow}>
            <img
              class={styles.arrowLeaf}
              src={
                active
                  ? ASSETS.arrowWhite
                  : assetSet === 'teams-page'
                    ? ASSETS.teamsIconArrow
                    : ASSETS.arrowBlack
              }
              alt=""
              aria-hidden="true"
            />
          </span>
        )}
      </Fragment>
    )
  }

  {
    variant === 'filter' && (
      <Fragment>
        <span class={styles.filterLabel}>{label}</span>
        {showIcon && (
          <span class={styles.clear} data-filter-clear hidden={!active}>
            <img
              class={styles.clearRing}
              src={assetSet === 'teams-page' ? ASSETS.teamsActiveRing : ASSETS.clearRing}
              alt=""
              aria-hidden="true"
            />
            <img
              class={styles.clearCross}
              src={assetSet === 'teams-page' ? ASSETS.teamsActiveCross : ASSETS.clearCross}
              alt=""
              aria-hidden="true"
            />
          </span>
        )}
      </Fragment>
    )
  }

  {
    variant === 'fanduel' && (
      <Fragment>
        {showIcon && (
          <span class={styles.fanduelMark}>
            <img
              class={styles.fanduelMarkLeaf}
              src={assetSet === 'teams-page' ? ASSETS.teamsFanduelMask : ASSETS.fanduelMark}
              alt=""
              aria-hidden="true"
            />
          </span>
        )}
        <span class={styles.fanduelLabel}>{label}</span>
      </Fragment>
    )
  }
</Element>

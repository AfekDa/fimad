---
/**
 * Bottom navigation — Figma component "Nav", variant Type=Mobile (1:129), as
 * instanced on the Homepage (1:127).
 *
 * Tabs are links and the current one is marked from the URL, so a page never
 * declares which tab it is on. Tabs whose screen does not exist yet carry no
 * `href` and render inert — see navItems.ts.
 *
 * Still no JavaScript: navigation and focus are the platform's.
 */
import Icon from '../Icon/Icon.astro'
import { NAV_ITEMS } from './navItems'
import styles from './Nav.module.css'

export interface Props {
  readonly class?: string | undefined
  /**
   * Overrides the current route. Only needed when rendering outside a page —
   * component tests, for instance, which have no real request behind them.
   */
  readonly currentPath?: string | undefined
}

const { class: className, currentPath } = Astro.props

/** `/buttons/` and `/buttons` are the same route; the build emits the former. */
function normalise(path: string): string {
  const trimmed = path.replace(/\/+$/, '')
  return trimmed === '' ? '/' : trimmed
}

const here = normalise(currentPath ?? Astro.url.pathname)
---

<nav class:list={[styles.nav, className]} aria-label="Primary" data-node-id="1:127">
  {
    NAV_ITEMS.map((item) =>
      item.href === undefined ? (
        <span class={styles.item} data-nav-id={item.id} aria-disabled="true">
          <Icon name={item.icon} />
          <span class={styles.label}>{item.label}</span>
        </span>
      ) : (
        <a
          class={styles.item}
          href={item.href}
          data-nav-id={item.id}
          aria-current={normalise(item.href) === here ? 'page' : undefined}
        >
          <Icon name={item.icon} />
          <span class={styles.label}>{item.label}</span>
        </a>
      ),
    )
  }
</nav>

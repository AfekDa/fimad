---
/**
 * Bottom navigation — Figma component "Nav", variant Type=Mobile (1:129), as
 * instanced on the Homepage (1:127).
 *
 * The selected tab is a native radio group rather than component state: the
 * Figma page contains only one full-screen frame, so no prototype destination
 * exists for the other tabs, and the platform gives us selection, keyboard
 * support and screen-reader semantics without shipping any JavaScript.
 */
import Icon from '../Icon/Icon.astro'
import { NAV_ITEMS } from './navItems'
import styles from './Nav.module.css'

export interface Props {
  /** Id of the item that starts checked. Must match an id in NAV_ITEMS. */
  readonly selectedId: string
  readonly class?: string | undefined
  /** Radio group name; distinct per instance if a page ever renders two navs. */
  readonly name?: string | undefined
}

const { selectedId, class: className, name = 'nav-tab' } = Astro.props

if (!NAV_ITEMS.some((item) => item.id === selectedId)) {
  throw new Error(`Nav selectedId "${selectedId}" is not one of the design's items.`)
}
---

<nav class:list={[styles.nav, className]} aria-label="Primary" data-node-id="1:127">
  {
    NAV_ITEMS.map((item) => (
      <Fragment>
        <input
          class={styles.navInput}
          type="radio"
          name={name}
          id={`${name}-${item.id}`}
          checked={item.id === selectedId}
        />
        <label class={styles.item} for={`${name}-${item.id}`}>
          <Icon name={item.icon} />
          <span class={styles.label}>{item.label}</span>
        </label>
      </Fragment>
    ))
  }
</nav>

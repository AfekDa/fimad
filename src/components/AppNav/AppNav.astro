---
/**
 * Canonical mobile application navigation — Homepage Nav 1:126 / 1:127.
 *
 * The component owns the dock, scrim, bar, icon exports, and route state. A
 * screen can render AppNav, but cannot restyle it or select a screen-specific
 * asset set. That boundary keeps the application chrome identical by design.
 */
import Icon from '../Icon/Icon.astro'
import { ASSETS } from '../../assets/assets'
import styles from './AppNav.module.css'
import { APP_NAV_ITEMS } from './navItems'

export interface Props {
  /** Only for isolated component tests, where Astro has no route request. */
  readonly currentPath?: string | undefined
}

const { currentPath } = Astro.props

function normalise(path: string): string {
  const trimmed = path.replace(/\/+$/, '')
  return trimmed === '' ? '/' : trimmed
}

const here = normalise(currentPath ?? Astro.url.pathname)

function isCurrent(href: string): boolean {
  const destination = normalise(href)
  return destination === '/' ? here === '/' : here === destination || here.startsWith(`${destination}/`)
}
---

<div
  class={styles.dock}
  data-app-nav-dock
  data-node-id="1:126"
  data-desktop-node-id="366:295"
>
  <nav
    class={styles.nav}
    aria-label="Primary"
    data-app-nav
    data-node-id="1:127"
  >
    <div class={styles.items}>
      {
        APP_NAV_ITEMS.map((item) => {
        const icon = <Icon class={styles.itemIcon} name={item.icon} />

        return item.href === undefined ? (
          <span class={styles.item} data-nav-id={item.id} aria-disabled="true">
            {icon}
            <span class={styles.label}>{item.label}</span>
          </span>
        ) : (
          <a
            class={styles.item}
            href={item.href}
            data-astro-prefetch="viewport"
            data-nav-id={item.id}
            aria-current={isCurrent(item.href) ? 'page' : undefined}
          >
            {icon}
            <span class={styles.label}>{item.label}</span>
          </a>
        )
        })
      }
    </div>

    <form class={styles.desktopSearch} role="search" data-desktop-nav-search>
      <img class={styles.searchIcon} src={ASSETS.teamsIconSearch} alt="" aria-hidden="true" />
      <input
        class={styles.searchInput}
        type="search"
        placeholder="Search team"
        aria-label="Search team"
        autocomplete="off"
        data-nav-team-search
      />
      <button class={styles.searchClear} type="reset" aria-label="Clear team search">
        <img class={styles.searchClearRing} src={ASSETS.teamsClearRing} alt="" aria-hidden="true" />
        <img class={styles.searchClearCross} src={ASSETS.teamsClearCross} alt="" aria-hidden="true" />
      </button>
    </form>
  </nav>
</div>

<script>
  import { TEAMS } from '../../data/teams'

  /*
   * The nav search takes the user to a team page on an EXACT name match only
   * (27 Aug feedback: desktop search did not work at all). Anything short of a
   * full team name changes nothing -- the field is a navigator, not a filter,
   * because the nav is global and has no card list of its own to narrow.
   */
  function startNavTeamSearch() {
    const search = document.querySelector<HTMLInputElement>('[data-nav-team-search]')

    // The nav is on every route, but astro:page-load re-runs this per swap, so
    // the listener must only ever bind to the document currently on screen.
    if (search === null || search.dataset.wired === 'true') return
    search.dataset.wired = 'true'

    function navigateOnExactMatch() {
      if (search === null) return
      const query = search.value.trim().toLocaleLowerCase()
      if (query.length === 0) return

      const team = TEAMS.find((candidate) => candidate.name.toLocaleLowerCase() === query)
      if (team !== undefined) window.location.assign(team.href)
    }

    search.addEventListener('input', navigateOnExactMatch)
    search.form?.addEventListener('submit', (event) => {
      event.preventDefault()
      navigateOnExactMatch()
    })
  }

  document.addEventListener('astro:page-load', startNavTeamSearch)
</script>
